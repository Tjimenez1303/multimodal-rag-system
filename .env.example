# Copy to .env (git-ignored) and adjust. Compose reads this file on `docker compose up`.
#
# One-time prerequisite: enable Docker Model Runner so the models run on the host GPU.
#   macOS and Windows: docker desktop enable model-runner --tcp 12434 --cors none
#   Linux:             install the docker-model-plugin package
# Compose then pulls ai/qwen3.5:9b and ai/qwen3-embedding:0.6b (about 7.2 GB, once)
# and injects VLM_URL, VLM_MODEL, EMBEDDER_URL and EMBEDDER_MODEL into the worker, and
# ANSWER_MODEL_URL, ANSWER_MODEL, EMBEDDER_URL and EMBEDDER_MODEL into the API.

# --- Database (required) ---------------------------------------------------------------
POSTGRES_USER=rag
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rag

# --- Logging ---------------------------------------------------------------------------
# json for production-style logs, console for local reading.
LOG_FORMAT=json
LOG_LEVEL=INFO

# --- API -------------------------------------------------------------------------------
# Host port that publishes the API, on 127.0.0.1 only.
API_PUBLISHED_PORT=8000
# Upload limits: 200 MB and 500 pages by default.
MAX_UPLOAD_BYTES=209715200
MAX_UPLOAD_PAGES=500

# --- Jobs ------------------------------------------------------------------------------
# Attempts per ingestion job before it fails with interrupted_repeatedly. Read by the
# API, which stores it on each job, and by the worker, which enforces it.
MAX_ATTEMPTS=3

# --- Worker ----------------------------------------------------------------------------
# Set to false to skip figure descriptions and ingest faster.
FIGURE_DESCRIPTION_ENABLED=true

# Every setting below has a default in backend/src/multimodal_rag/shared/config.py.
# To change one, add it to the service's environment in compose.yaml.
#
# Required inside the containers, set by compose.yaml, never needed here:
#   DATABASE_URL        postgresql+asyncpg://... built from the POSTGRES_* values
#   BLOB_ROOT           /data/blobs, the shared volume
#   QDRANT_URL          http://qdrant:6333
#   VLM_URL, VLM_MODEL, EMBEDDER_URL, EMBEDDER_MODEL   injected by the models element
#   ANSWER_MODEL_URL, ANSWER_MODEL                     injected into the API the same way
#   EMBEDDER_TOKENIZER_PATH   tokenizer.json baked into the image from
#                             backend/embedder_tokenizer.txt
#
# API process inside its container:
#   API_HOST=0.0.0.0              interface uvicorn listens on (compose publishes 127.0.0.1)
#   API_PORT=8000                 port uvicorn listens on inside the container
#   READINESS_TIMEOUT_SECONDS=2   deadline of each readiness probe
#
# Question answering (API):
#   RETRIEVAL_TOP_K=8             retrieval units supplied to the answer model
#   MIN_SIMILARITY=0.60           lowest meaning similarity that lets a unit pass the
#                                 relevance gate, below it the answer is "not enough
#                                 information" without asking the model
#   LOW_CONFIDENCE_THRESHOLD=0.90 recognized text below it is flagged in the sources
#   MAX_QUESTION_CHARS=2000       longest question
#   MAX_FILTER_DOCUMENTS=20       most documents a question may be restricted to
#   ANSWER_MAX_TOKENS=800         longest answer
#   ANSWER_TEMPERATURE=0          sampling temperature, 0 gives reproducible answers
#   ANSWER_CONCURRENCY=2          questions answered at the same time
#   ANSWER_QUEUE_LIMIT=10         questions waiting, further ones get answering_busy
#   ANSWER_DEADLINE_SECONDS=90    total time of a question, waiting included
#   ATTRIBUTION_MIN_SCORE=0.5     lowest word and meaning match that cites a statement
#                                 of an answer the model wrote without source markers
#   EMBEDDER_QUERY_INSTRUCTION="Given a question about a technical manual, retrieve the passages that answer it"
#                                 task sentence the embedding model receives with
#                                 each question
#
# Timeouts of external calls:
#   DB_CONNECT_TIMEOUT_SECONDS=5
#   DB_STATEMENT_TIMEOUT_MS=15000
#   DB_POOL_SIZE=10
#   DB_POOL_TIMEOUT_SECONDS=10
#   QDRANT_TIMEOUT_SECONDS=10
#   VLM_TIMEOUT_SECONDS=120
#   EMBEDDER_TIMEOUT_SECONDS=60
#   ANSWER_MODEL_TIMEOUT_SECONDS=60   one answer generation, shorter than the deadline
# Retries of transient provider failures (exponential backoff with jitter):
#   PROVIDER_RETRY_ATTEMPTS=4
#   PROVIDER_RETRY_INITIAL_WAIT_SECONDS=0.5
#   PROVIDER_RETRY_MAX_WAIT_SECONDS=10
#   PROVIDER_RETRY_JITTER_SECONDS=1
#   PROVIDER_RETRY_TIMEOUT_SECONDS=300   total budget across all attempts
# Job leases:
#   LEASE_SECONDS=90
#   HEARTBEAT_SECONDS=30
#   POLL_SECONDS=2
#   CLAIM_RETRY_MAX_WAIT_SECONDS=30   ceiling of the backoff while the database is down
#   CLAIM_RETRY_JITTER_SECONDS=1      random amount added to each of those waits
#   WORKER_MAX_JOBS=20   jobs before the worker exits and compose restarts it
#   LIVENESS_FILE=/tmp/multimodal-rag-worker.alive   checked by the compose healthcheck
#   LIVENESS_INTERVAL_SECONDS=10
#   LIVENESS_MAX_AGE_SECONDS=60   older liveness file means the worker is stuck
# Extraction and indexing:
#   EXTRACTION_PAGE_BATCH=4
#   EXTRACTION_THREADS=4
#   EXTRACTION_BATCH_TIMEOUT_SECONDS=120   Docling's recommended conversion timeout
#   DOCLING_ARTIFACTS_PATH=/opt/docling-models   extraction models baked into the image
#   FIGURE_CONCURRENCY=2
#   MAX_UNIT_TOKENS=480
#   EMBEDDER_DIMENSIONS=1024        length of the embedding vectors
#   EMBEDDER_BATCH_SIZE=32          passages per embedding request, worker and API
#   EMBEDDER_MAX_INPUT_TOKENS=2048  longest embedding input, the model's --ubatch-size
#   QDRANT_COLLECTION=retrieval_units
# Figure rules:
#   DECORATIVE_MIN_PAGES=3
#   DECORATIVE_MIN_PAGE_SHARE=0.2
#   NEAR_TEXT_MAX_POINTS=72
