    "get-nonce": "^1.0.1",
    "lucide-react": "^1.48.0",
    "mdast-util-find-and-replace": "^3.0.2",
    "nanoid": "^6.0.1",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.0",
